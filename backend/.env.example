# ---- Copy to .env (or run "npm run init", which also generates JWT_SECRET) ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Where the website is served from (used for CORS and links).
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma separated (only needed if the frontend is on another domain).
CORS_ORIGINS=
# Serve ../frontend from this server too (true = one server for site + API).
SERVE_FRONTEND=true
FRONTEND_DIR=../frontend

# SQLite database file.
DATABASE_URL=file:./database/sohastics.sqlite
UPLOAD_DIR=./uploads
# Prefix for uploaded-file URLs when the API lives on a different domain, e.g. https://api.example.com
PUBLIC_URL=

# Required in production: 32+ random characters.  (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
SESSION_HOURS=12
# Cookie settings. Use COOKIE_SAMESITE=None (needs HTTPS) only if the frontend is on a different site.
COOKIE_SAMESITE=Lax
COOKIE_SECURE=
# Set true when running behind nginx / a load balancer so client IPs are read from X-Forwarded-For.
TRUST_PROXY=false

# Fill an empty database with the website's original text on first start (false = start blank).
SEED_DEFAULTS=true

MAX_IMAGE_MB=8
MAX_VIDEO_MB=100
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# Optional: creates the first admin automatically on first start. Remove the password afterwards.
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-long-password-1
